# Copiar este archivo como .env y colocar los datos del proyecto de Supabase.
# Supabase > Project Settings > Database > Connection string > "Session pooler"
# NO usar comillas en los valores.

# Host del Session Pooler, ej: aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
# En el pooler el usuario lleva el id del proyecto: postgres.<project-ref>
SUPABASE_DB_USER=postgres.TU_PROJECT_REF
SUPABASE_DB_PASSWORD=TU_CONTRASENA_DE_BASE_DE_DATOS

# Opcionales
DB_POOL_SIZE=5
# none | validate
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
# Dominios del frontend permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Seguridad JWT (obligatorio) =====
# Clave en Base64 de al menos 32 bytes. Generar con: openssl rand -base64 48
JWT_SECRET=
# Duracion del token en ms (8 horas)
JWT_EXPIRACION_MS=28800000

# ===== Autenticacion =====
# false solo en desarrollo: crea las cuentas del portal sin pedir el codigo enviado por correo
AUTH_VERIFICACION_CORREO=true
# Opcional: correo de un empleado administrador existente en Supabase y su contraseña inicial
# (solo se aplica si ese empleado aun no tiene contraseña). Borrar despues del primer arranque.
ADMIN_INICIAL_CORREO=
ADMIN_INICIAL_CONTRASENA=

# ===== Correo SMTP (codigos de verificacion) =====
# En Gmail usar una "contraseña de aplicacion"
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
