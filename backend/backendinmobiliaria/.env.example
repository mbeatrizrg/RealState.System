# Copiar este archivo como .env y colocar los datos del proyecto de Supabase.
# Supabase > Project Settings > Database > Connection string > "Session pooler"
# NO usar comillas en los valores.

# Host del Session Pooler, ej: aws-0-us-east-1.pooler.supabase.com
SUPABASE_DB_HOST=aws-0-REGION.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
# En el pooler el usuario lleva el id del proyecto: postgres.<project-ref>
SUPABASE_DB_USER=postgres.TU_PROJECT_REF
SUPABASE_DB_PASSWORD=TU_CONTRASENA_DE_BASE_DE_DATOS

# Opcionales
DB_POOL_SIZE=5
# none | validate
JPA_DDL_AUTO=none
JPA_SHOW_SQL=false
# Dominios del frontend permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173
